      <identification contact="at gmail.com - juan.delafiguera" author="juan.delafiguera" emailDomain="gmail.com" classFamily="MeasureInstruments" siteSpecific="" platform="All Platforms" bus="Ethernet" manufacturer="Elmitec" reference="LEEM2000"/>
    </description>
    <deviceProperties name="IP" description="">
      <type xsi:type="pogoDsl:StringType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>tvips.lab</DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="Port" description="">
      <type xsi:type="pogoDsl:UShortType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>5566</DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="Timeout" description="Seconds to wait on the socket. Without one, a program that is alive but silent blocked a read for ever.">
      <type xsi:type="pogoDsl:DoubleType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>5.0</DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="ReconnectPeriod" description="Seconds between attempts to rebuild the link while it is down.">
      <type xsi:type="pogoDsl:DoubleType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>10.0</DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="DeadmanTimeout" description="Seconds without a Keepalive command after which P2Lens is dropped to P2LensOffValue, as P2lensOFF would. 0 disables the deadman (default). Set it comfortably above the restart time of whatever sends the keepalives - an AnalogInterlock watching the P2 cooling water.">
      <type xsi:type="pogoDsl:DoubleType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>0.0</DefaultPropValue>
    </deviceProperties>
