    </deviceProperties>
    <deviceProperties name="DevicePath" description="Which card, when more than one is connected. The hidapi path, as hid.enumerate() reports it. Empty picks the first matching VendorID and InstrumentID. The serial number cannot be used: these cards report it empty.">
      <type xsi:type="pogoDsl:StringType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue></DefaultPropValue>
    </deviceProperties>
    <deviceProperties name="MCS_Channels" description="Channels in one full native MCS sweep (one drive period). 512 here, 256 on some setups. setMCAmode uses it as the channel count, and folding uses it as the N it folds over.">
      <type xsi:type="pogoDsl:UShortType"/>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
      <DefaultPropValue>512</DefaultPropValue>
    </deviceProperties>
