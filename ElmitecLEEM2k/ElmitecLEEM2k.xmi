  <classes name="ElmitecLEEM2k" pogoRevision="9.4">
    <description description="Device server for accessing the settings of the LEEM2000 program from Elmitec." title="ElmitecLEEM2k" sourcePath="/home/juan/miNube/soft/SURFMOSS_TangoDS/ElmitecLEEM2k" language="PythonHL" filestogenerate="XMI   file,Code files,Python Package,Protected Regions" license="GPL" copyright="" hasMandatoryProperty="false" hasConcreteProperty="true" hasAbstractCommand="false" hasAbstractAttribute="false">
