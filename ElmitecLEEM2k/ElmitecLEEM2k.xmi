    <commands name="P2lensOFF" description="Drop P2Lens to the P2LensOffValue value, the current the lens holds with no cooling water, in response to a P2 water cut. Disarms the deadman." execMethod="p2lens_off" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="P2lensON" description="Restore P2Lens to the P2LensOnValue value once the P2 cooling water is back. Arms and refreshes the deadman and clears a trip." execMethod="p2lens_on" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argin>
      <argout description="">
        <type xsi:type="pogoDsl:VoidType"/>
      </argout>
      <status abstract="false" inherited="false" concrete="true" concreteHere="true"/>
    </commands>
    <commands name="Keepalive" description="Refreshes the deadman timer only. Never moves P2Lens: recovering from a deadman trip needs an explicit P2lensON." execMethod="keepalive" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
      <argin description="">
