    <commands name="CalibrateFoldPoint" description="Run the mirror-chi2 fold-point search over the full raw MCS sweep and store the result in FoldPoint. Call once at the start of a measurement; not in a loop. MCS analog mode, full untruncated sweep only." execMethod="calibrate_fold_point" displayLevel="OPERATOR" polledPeriod="0" isDynamic="false">
